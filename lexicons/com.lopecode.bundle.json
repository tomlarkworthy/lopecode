{
  "id": "com.lopecode.bundle",
  "defs": {
    "main": {
      "key": "tid",
      "type": "record",
      "record": {
        "type": "object",
        "required": [
          "title",
          "files",
          "createdAt"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "ref": "#fileEntry",
              "type": "ref"
            }
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "required": [
        "id",
        "encoding",
        "blob"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1000,
          "description": "Script tag id, e.g. `@user/module`, `@user/module/asset.png`, `bootconf.json`"
        },
        "blob": {
          "type": "blob",
          "description": "atproto blob ref — CID (v1 raw + sha-256), mimeType, size"
        },
        "encoding": {
          "enum": [
            "text",
            "base64"
          ],
          "type": "string"
        }
      }
    }
  },
  "lexicon": 1
}
