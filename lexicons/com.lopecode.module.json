{
  "lexicon": 1,
  "id": "com.lopecode.module",
  "description": "One version of an Observable module of lopecode: its compiled text, its files, and the versions of the modules it imports.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A module version. A record is never rewritten; a new version is a new record whose prev names the one it follows.",
      "record": {
        "type": "object",
        "required": [
          "id",
          "source",
          "imports",
          "attachments",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "description": "The module id, @user/name, e.g. @tomlarkworthy/brain-store."
          },
          "source": {
            "type": "blob",
            "description": "The compiled module text, text/javascript. Its CID is v1 raw + sha-256."
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#import"
            },
            "description": "Each module the source imports, but the built-ins, pinned to a record."
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "ref",
              "ref": "#fileEntry"
            },
            "description": "The files of the module."
          },
          "prev": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The version this one follows."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "import": {
      "type": "object",
      "required": [
        "id",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 200,
          "description": "The id of the imported module, @user/name."
        },
        "ref": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef",
          "description": "The com.lopecode.module record of the imported version."
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "required": [
        "name",
        "encoding",
        "blob"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000,
          "description": "The file name, as the module's FileAttachment names it."
        },
        "encoding": {
          "type": "string",
          "description": "How the file is held, e.g. text or base64."
        },
        "blob": {
          "type": "blob",
          "description": "atproto blob ref: CID (v1 raw + sha-256), mimeType, size."
        }
      }
    }
  }
}
